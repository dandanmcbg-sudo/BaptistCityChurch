rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'tSirLJ49mPTM2wo7kpmAxbqT7Rj2';
    }

    function validPublicRegistration(memberId) {
      let d = request.resource.data;
      return request.auth == null
        && d.keys().hasOnly([
          'id', 'name', 'category', 'email', 'contact', 'ministry',
          'firstTimeVisitor', 'invitedBy', 'contactMethod', 'birthday',
          'prayerRequest', 'reminderConsent', 'reminderEnabled',
          'totalAttendance', 'lastAttended', 'notes', 'updatedAt'
        ])
        && d.keys().hasAll(['name', 'category', 'totalAttendance'])
        && d.name is string
        && d.name.size() > 0 && d.name.size() <= 150
        && d.category in ['Member', 'Visitor', 'Guest']
        && d.totalAttendance is int
        && d.totalAttendance == 1
        && d.lastAttended is string
        && d.lastAttended.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
        && (!('email' in d) || (d.email is string && d.email.size() <= 254))
        && (!('contact' in d) || (d.contact is string && d.contact.size() <= 40))
        && (!('prayerRequest' in d) || (d.prayerRequest is string && d.prayerRequest.size() <= 2000))
        && (!('reminderConsent' in d) || d.reminderConsent is bool)
        && (!('reminderEnabled' in d) || d.reminderEnabled is bool)
        && (!('id' in d) || d.id == memberId);
    }

    function validPublicCheckin() {
      let before = resource.data;
      let after = request.resource.data;
      return request.auth == null
        && request.time != null
        && after.diff(before).affectedKeys().hasOnly(['totalAttendance','lastAttended'])
        && before.totalAttendance is int
        && after.totalAttendance == before.totalAttendance + 1
        && after.lastAttended is string
        && after.lastAttended.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && after.lastAttended != before.get('lastAttended', '')
        && after.lastAttended.size() == 10;
    }
    match /publicAttendees/{memberId} {
      allow read: if true;
      allow create: if isAdmin() || (request.auth == null
        && request.resource.data.keys().hasOnly(['name','category'])
        && request.resource.data.keys().hasAll(['name','category'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150
        && request.resource.data.category in ['Member','Visitor','Guest']);
      allow update, delete: if isAdmin();
    }
    match /members/{memberId} {
      allow read, delete: if isAdmin();
      allow update: if isAdmin() || validPublicCheckin();
      allow create: if isAdmin() || validPublicRegistration(memberId);
    }

    match /churchEvents/{eventId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
